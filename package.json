{
  "name": "coflorist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CoFlorist: conversational flower collaboration dashboard",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/app.js",
    "dev": "node --env-file-if-exists=.env --watch server/app.js",
    "test": "node --test tests/*.test.js",
    "setup:voice": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-voice.ps1"
  },
  "dependencies": { "express": "^5.2.1" }
}
