# 이 파일을 .env로 복사한 뒤 값을 채웁니다. .env는 저장소에 올리지 않습니다.

# 기기가 접속할 때 쓰는 암호. 아무 문자열이나 길게 정합니다.
DUO_DEVICE_TOKEN=

# 경우 선택: 1 = 네모트론 + 제미나이, 2 = 솔라 + 제미나이
DUO_CASE=1

# 음성 인식: gemini 또는 nvidia (Nemotron 음성 인식). 키 없이 흐름만 볼 때는 fake
DUO_STT=gemini
# 답변·음성 합성을 따로 고르려면 주석을 풉니다 (fake = 키 없이 동작하는 가짜)
# DUO_LLM=nemotron
# DUO_TTS=gemini

# 키. 고른 조합에 필요한 것만 채우면 됩니다.
GEMINI_API_KEY=
NEBIUS_API_KEY=
UPSTAGE_API_KEY=
NVIDIA_API_KEY=
# 답변을 OpenAI 모델로 하려면 (DUO_LLM=openai). 코덱스 CLI의 ChatGPT 로그인은 쓸 수 없고 platform.openai.com 의 API 키여야 함
OPENAI_API_KEY=

# 로봇이 집을 수 있는 꽃 색 목록(쉼표 구분). 기본값은 대시보드(CoFlorist) 배치 목록과 같은 white,red,yellow,purple. 꽃집이 바뀌면 여기만 바꾸면 프롬프트·검증이 같이 따라감.
# DUO_FLOWER_COLORS=white,red,yellow,purple

# 기기 스피커 볼륨(0~100). 적으면 기기가 붙을 때마다 이 값으로 맞춥니다(기기가 저장함). 비우면 건드리지 않음. 펌웨어 기본값 70.
# DUO_DEVICE_VOLUME=50

# 기기 마이크로 들어온 소리를 파일로 남기려면 폴더를 적습니다 (마이크 확인용, 평소에는 비워 둠)
# DUO_SAVE_AUDIO_DIR=logs/audio

# 모델 이름 (2026-09-29 공식 문서 기준 기본값이 들어 있어 비워 둬도 됩니다)
# GEMINI_STT_MODEL=gemini-3.5-transcribe
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Kore
# NEMOTRON_MODEL=nvidia/Nemotron-3_5-Lightning
# SOLAR_MODEL=solar-mini4
# OPENAI_MODEL=gpt-5.6

# ---- 인터넷 공개 (등록 방식) ----
# 초대 코드를 적으면 등록 페이지(/register)가 켜지고, 공용 주소(/xiaozhi/ota/)는 꺼집니다.
# 기기를 붙이려는 사람은 /register 에서 이 코드와 자기 API 키를 넣고 자기만의 접속 주소를 받습니다.
# 서버에 없는 키(업스테이지·OpenAI·제미나이)는 등록하는 사람이 냅니다. 제미나이 키를 안 내면 그 사람은 글 대화만 되고 음성은 안 됩니다.
# 등록하면 글 대화 페이지(/d/<비밀>/chat)와 기기 접속 주소(/d/<비밀>/xiaozhi/ota/)를 받습니다.
# DUO_INVITE_CODE=
# 등록 장부 파일 (키가 들어 있으므로 저장소에 올리지 않음)
# DUO_REGISTRY_PATH=data/registrations.json
# 바깥에서 보이는 주소 (Tailscale Funnel 등). 비우면 요청 헤더로 알아냅니다.
# DUO_PUBLIC_URL=https://<이름>.ts.net
# 등록 화면의 키 칸을 아예 숨기려면 0 (등록하는 사람은 이름·초대 코드만 넣고, 모든 사람의 대화를 서버의 키로 처리). 서버 .env에 답변 모델 키가 있어야 켜져요.
# DUO_REGISTER_ASK_KEYS=1
# 같은 와이파이용 공용 주소(/xiaozhi/ota/, DUO_DEVICE_TOKEN)를 같이 켜려면 1. 인터넷에 열 때는 켜지 말 것.
# DUO_LEGACY_ROUTES=1
